{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32 Debug (ST-Link)",
            "cwd": "${workspaceFolder}",
            "executable": "./MDK-ARM/Boat_STM32/Boat_STM32.axf",  // 这里改成你自己的axf文件路径
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "stlink",
            "device": "STM32H743IIT6",  // 改成你的芯片型号
            "interface": "swd",
            "svdFile": "STM32H743IITx.svd", // 可选，不填也能调试
            //"preLaunchTask": "Build",
        }
    ]
}